# What goes into the source distribution beyond the package itself.
include LICENSE
include README.md
include CHANGELOG.md
include CITATION.cff
include CONTRIBUTING.md
include environment.yml
include pytest.ini
recursive-include discoolpy/templates *.yaml
recursive-include configs *.yaml
recursive-include tests *.py
recursive-include docs *.md *.py *.txt Makefile
graft examples
prune examples/tutorial_outputs
prune outputs
global-exclude __pycache__ *.py[cod] *.so .DS_Store
